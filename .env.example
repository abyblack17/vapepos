# ============================================================
# VapePOS — Variables de entorno
# Copia este archivo como .env y completa con tus credenciales
# ============================================================

# Firebase — obtenlas en console.firebase.google.com
# Project Settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=tu_api_key
VITE_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu_proyecto_id
VITE_FIREBASE_STORAGE_BUCKET=tu_proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_sender_id
VITE_FIREBASE_APP_ID=tu_app_id
VITE_FIREBASE_APPCHECK_SITE_KEY=tu_clave_de_sitio_recaptcha_enterprise
VITE_FIREBASE_APPCHECK_PROVIDER=enterprise
# Solo desarrollo local. Nunca activar en producción.
VITE_APPCHECK_DEBUG=false

# Opcional: región de las Cloud Functions (default: us-central1)
VITE_FUNCTIONS_REGION=us-central1
